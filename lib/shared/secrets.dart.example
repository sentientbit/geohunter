/// Runtime secrets — copy this file to secrets.dart and fill in real values.
/// secrets.dart is git-ignored and must never be committed.
///
/// Android secrets (google API key, admob) go in android/local.properties (also gitignored):
///   googleApiKey=YOUR_GOOGLE_API_KEY
///   admobAppId=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
///
/// Android release signing goes in android/key.properties (gitignored):
///   storeFile=../app/your-keystore.jks
///   storePassword=YOUR_STORE_PASSWORD
///   keyAlias=YOUR_KEY_ALIAS
///   keyPassword=YOUR_KEY_PASSWORD
class AppSecrets {
  /// Mapbox public access token (pk.*).
  /// Create one at https://account.mapbox.com/access-tokens/
  /// Restrict it to your app's bundle ID in the Mapbox dashboard.
  static const String mapboxToken = 'pk.YOUR_MAPBOX_TOKEN_HERE';

  /// Sentry Data Source Name for crash reporting.
  /// Find yours at https://sentry.io → Project → Settings → Client Keys (DSN)
  static const String sentryDsn = 'https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX';
}
